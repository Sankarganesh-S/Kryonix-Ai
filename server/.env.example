ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.6:5173
APP_ENV=dev
SECRET_KEY=your_secret_key_here
DATABASE_URL=postgresql://postgres:your_password_here@127.0.0.1:5432/kryonix
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llava:7b
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
EMAIL_FROM=Kryonix AI <your_email_here>
OTP_EMAIL_SUBJECT_REGISTER=Confirm your Kryonix AI registration
OTP_EMAIL_SUBJECT_LOGIN=Your Kryonix AI sign-in code
OTP_EMAIL_SUBJECT_RESET=Reset your Kryonix AI password
FRONTEND_URL=http://localhost:5173
ADMIN_SECRET=your_admin_secret_here