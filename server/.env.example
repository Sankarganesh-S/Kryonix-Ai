# ── App ──────────────────────────────────────
APP_ENV=dev
SECRET_KEY=change-me-generate-with-python-secrets

# ── PostgreSQL ────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/kryonix

# ── JWT ──────────────────────────────────────
JWT_SECRET_KEY=change-me-too
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Ollama (your own AI) ──────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# ── Email (your own SMTP) ────────────────────
# Gmail: use App Password (not your real password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Kryonix AI <you@gmail.com>
FRONTEND_URL=http://localhost:5173

# ── Admin ────────────────────────────────────
ADMIN_SECRET=create-first-admin-with-this-secret
